# ─────────────────────────────────────────────────────────────
# UMi — Portail Psy — Variables d'environnement (TEMPLATE)
# Copie ce fichier en `.env.local` puis renseigne les valeurs.
# ⚠️ Ne mets JAMAIS de vraie clé ici : `.env.example` est versionné (git).
# ─────────────────────────────────────────────────────────────

# Supabase — valeurs PUBLIQUES (exposées au navigateur → préfixe NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<cle_anon_publique>

# Resend — SECRET (serveur uniquement, jamais exposé au navigateur)
RESEND_API_KEY=<cle_api_resend>
RESEND_FROM_EMAIL=UMi <no-reply@ton-domaine.fr>

# URL publique du site (liens emails, redirections auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (Optionnel / avancé) Admin serveur — contourne la RLS. À éviter si possible.
# SUPABASE_SERVICE_ROLE_KEY=<cle_service_role_tres_sensible>
